{
  "name": "trip-monorepo",
  "private": true,
  "scripts": {
    "dev:frontend": "pnpm --filter frontend dev",
    "dev:backend": "cd backend-py && .venv/bin/uvicorn app.main:create_app --factory --reload --port 3001",
